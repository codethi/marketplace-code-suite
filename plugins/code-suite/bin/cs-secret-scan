#!/usr/bin/env bash
# cs-secret-scan — scan added lines for secrets. Needs only git, awk and grep.
#
# Usage:
#   cs-secret-scan --staged          staged changes
#   cs-secret-scan --worktree        changes vs HEAD + untracked text files (<= 1 MB)
#   cs-secret-scan --range [BASE]    BASE...HEAD (default BASE: origin/HEAD,
#                                    origin/main, origin/master, main, master)
#
# Strong patterns apply to every file. Generic patterns (literal assignments
# to api key/secret/token/password names, credentials inside URLs) apply only
# to production code: test, fixture, mock, example and doc paths and .md files
# are skipped. A line containing "secret-scan:allow" is ignored.
#
# Prints only file:line and the finding type, never the matched value.
# Exit: 0 clean, 1 findings, 2 usage or git error.

set -u

export GIT_OPTIONAL_LOCKS=0

MAX_UNTRACKED_BYTES=1048576

usage() { sed -n '4,8p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
fail()  { echo "cs-secret-scan: $*" >&2; exit 2; }

mode=""
base=""
while [ $# -gt 0 ]; do
  case "$1" in
    --staged|--worktree)
      [ -z "$mode" ] || usage; mode=${1#--} ;;
    --range)
      [ -z "$mode" ] || usage; mode=range
      if [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; then base=$2; shift; fi ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
  shift
done
[ -n "$mode" ] || usage

root=$(git rev-parse --show-toplevel 2>/dev/null) || fail "não está dentro de um repositório git"

gitc() {
  git -C "$root" --no-optional-locks -c core.quotePath=false "$@"
}

diff_opts="-U0 --no-color --no-ext-diff --no-textconv --src-prefix=a/ --dst-prefix=b/"
empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904

# Emits untracked text files (<= MAX_UNTRACKED_BYTES) as an all-added diff.
untracked_as_diff() {
  local f
  gitc ls-files --others --exclude-standard -z | while IFS= read -r -d '' f; do
    [ -f "$root/$f" ] || continue
    grep -Iq . "$root/$f" 2>/dev/null || continue   # binary or empty
    awk -v p="$f" -v max="$MAX_UNTRACKED_BYTES" '
      { size += length($0) + 1; if (size > max) exit; buf[NR] = $0 }
      END {
        if (size > max) exit
        print "diff --git a/" p " b/" p
        print "+++ b/" p
        print "@@ -0,0 +1," NR " @@"
        for (i = 1; i <= NR; i++) print "+" buf[i]
      }' "$root/$f"
  done
}

produce_diff() {
  case "$mode" in
    staged)
      gitc diff --cached $diff_opts ;;
    worktree)
      local against=HEAD
      gitc rev-parse --verify -q HEAD >/dev/null || against=$empty_tree
      gitc diff $diff_opts "$against" || return 1
      untracked_as_diff ;;
    range)
      gitc diff $diff_opts "$base...HEAD" ;;
  esac
}

if [ "$mode" = range ]; then
  if [ -z "$base" ]; then
    for b in origin/HEAD origin/main origin/master main master; do
      if gitc rev-parse --verify -q "$b^{commit}" >/dev/null; then base=$b; break; fi
    done
    [ -n "$base" ] || fail "não foi possível detectar a base; informe: --range BASE"
  fi
  gitc rev-parse --verify -q "$base^{commit}" >/dev/null || fail "base inválida: $base"
  gitc rev-parse --verify -q HEAD >/dev/null || fail "o repositório ainda não tem commits"
fi

produce_diff | awk '
function nonprod(p,   l, n, seg, i, base) {
  l = tolower(p)
  n = split(l, seg, "/")
  for (i = 1; i < n; i++)
    if (seg[i] ~ /^(__)?(tests?|specs?|testdata|fixtures?|mocks?|examples?|docs?|snapshots)(__)?$/) return 1
  base = seg[n]
  if (base ~ /\.(md|mdx|markdown)$/) return 1
  if (base ~ /(^|[._-])(tests?|specs?|fixtures?|mocks?|examples?)([._-]|$)/) return 1
  n = split(p, seg, "/")
  if (seg[n] ~ /[a-z0-9](Test|Tests|Spec|IT)\.[A-Za-z]+$/) return 1   # FooTest.java, FooTests.cs
  return 0
}

function placeholder(v,   l) {
  l = tolower(v)
  if (l ~ /example|changeme|change_me|change-me|dummy|fake|placeholder|redacted|your[_-]|xxxx|\*\*\*/) return 1
  if (l ~ /process\.env|os\.environ|getenv|\$\{|\{\{|%\(|^\$[a-z_]|^<.*>$/) return 1
  if (l ~ /^(password|passwd|pass|pwd|secret|token|api_?key)$/) return 1
  return 0
}

function report(type) {
  if (type in seen) return
  seen[type] = 1
  print file ":" ln ": " type
  found++
}

function strong(s,   rest, tok, prev, off) {
  if (s ~ /AKIA[0-9A-Z]{16}/) report("chave AWS")
  if (s ~ /-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----/) report("chave privada PEM")
  if (s ~ /gh[pousr]_[A-Za-z0-9]{36}/ || s ~ /github_pat_[A-Za-z0-9_]{22,}/) report("token GitHub")
  if (s ~ /sk-ant-[A-Za-z0-9_-]{20,}/) report("chave Anthropic")
  # generic sk- keys: word-delimited, 20+ chars, at least one digit
  rest = s; off = 0
  while (match(rest, /sk-[A-Za-z0-9_-]{20,}/)) {
    tok = substr(rest, RSTART, RLENGTH)
    prev = (off + RSTART > 1) ? substr(s, off + RSTART - 1, 1) : ""
    if (prev !~ /[A-Za-z0-9_-]/ && tok !~ /^sk-ant-/ && tok ~ /[0-9]/) { report("chave sk-"); break }
    off += RSTART + RLENGTH - 1
    rest = substr(rest, RSTART + RLENGTH)
  }
  if (s ~ /xox[abposr]-[A-Za-z0-9-]{10,}/ || s ~ /hooks\.slack\.com\/services\/T[A-Z0-9]+\/B[A-Z0-9]+\/[A-Za-z0-9]+/) report("token Slack")
  if (s ~ /AccountKey=[A-Za-z0-9+\/]{40,}/) report("AccountKey do Azure Storage")
}

function generic(s,   low, rest, off, m, q, start, tail, end, val, cred, user, pass) {
  # assignment of a string literal to a secret-like name
  low = tolower(s); rest = low; off = 0
  while (match(rest, /(api[_-]?key|secret|token|passw(or)?d|pwd)(_?key|_?value)?["'\'']?[ \t]*(:=|=>|=|:)[ \t]*["'\''`]/)) {
    m = substr(rest, RSTART, RLENGTH)
    q = substr(m, length(m), 1)
    start = off + RSTART + RLENGTH
    tail = substr(s, start)
    end = index(tail, q)
    if (end > 0) {
      val = substr(tail, 1, end - 1)
      if (length(val) >= 8 && val !~ /[ \t]/ && !placeholder(val)) { report("atribuição de segredo literal"); break }
    }
    off += RSTART + RLENGTH - 1
    rest = substr(rest, RSTART + RLENGTH)
  }
  # credentials inside a URL: scheme://user:pass@host
  rest = s
  while (match(rest, /[A-Za-z][A-Za-z0-9+.-]*:\/\/[^\/:@ \t"'\''`]+:[^\/@ \t"'\''`]+@/)) {
    cred = substr(rest, RSTART, RLENGTH - 1)
    sub(/^[^:]*:\/\//, "", cred)
    user = substr(cred, 1, index(cred, ":") - 1)
    pass = substr(cred, index(cred, ":") + 1)
    if (!placeholder(pass) && !placeholder(user)) { report("credencial em URL"); break }
    rest = substr(rest, RSTART + RLENGTH)
  }
}

/^diff --git / { header = 1; file = ""; next }
header && /^\+\+\+ / {
  file = substr($0, 5)
  if (file == "/dev/null") { file = ""; next }
  gsub(/^"|"$/, "", file)
  sub(/^b\//, "", file)
  prod = !nonprod(file)
  next
}
/^@@ / {
  header = 0
  if (match($0, /\+[0-9]+/)) ln = substr($0, RSTART + 1, RLENGTH - 1) + 0
  next
}
header { next }
/^\+/ {
  if (file != "") {
    line = substr($0, 2)
    if (index(line, "secret-scan:allow") == 0) {
      delete seen
      strong(line)
      if (prod) generic(line)
    }
  }
  ln++
  next
}
END {
  if (found) { printf "cs-secret-scan: %d possível(is) segredo(s) encontrado(s)\n", found > "/dev/stderr"; exit 1 }
}
'
status=("${PIPESTATUS[@]}")
[ "${status[0]}" -eq 0 ] || fail "falha ao gerar o diff do git"
case "${status[1]}" in
  0) exit 0 ;;
  1) exit 1 ;;
  *) fail "falha na análise" ;;
esac
